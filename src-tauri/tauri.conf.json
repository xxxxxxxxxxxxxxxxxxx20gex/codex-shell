{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-shell",
  "version": "0.1.3",
  "identifier": "com.codexshell.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Shell",
        "width": 1280,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/codex",
      "binaries/codex-code-mode-host",
      "binaries/codex-windows-sandbox-setup",
      "binaries/codex-command-runner"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../licenses/Apache-2.0.txt",
      "../licenses/CODEX-NOTICE",
      "../licenses/README.md"
    ]
  }
}
